# Copy to `.env` and fill in. Used by offline_vllm_mci_eval.py (LLM evaluation).
# `.env` is git-ignored — never commit real tokens.

# OpenAI-compatible endpoint (e.g. a vLLM server) for LLM classification
SERVER_HOST="http://localhost:8000/v1"
API_KEY="EMPTY"
MODEL_NAME="openai/gpt-oss-20b"     # or e.g. google/medgemma-27b-it
TEMPERATURE=0.0
MAX_CONCURRENCY=32

# Hugging Face token (only needed to download gated models / embeddinggemma)
HF_TOKEN=""
